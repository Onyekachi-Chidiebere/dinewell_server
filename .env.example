# Runtime
NODE_ENV=production
PORT=3000
ALLOWED_ORIGINS=https://app.dinewell.ca,https://admin.dinewell.ca

# PostgreSQL (prefer DATABASE_URL on Railway)
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE
# Alternatively, omit DATABASE_URL and set every DB_* connection variable below.
DB=DATABASE_NAME
DB_USER=DATABASE_USER
DB_PASSWORD=DATABASE_PASSWORD
DB_HOST=DATABASE_HOST
DB_PORT=5432
DB_DIALECT=postgres
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
# Set one TLS trust option: a mounted CA path, or system CA trust.
DB_CA_CERT_PATH=/path/to/postgres-ca.pem
DB_SSL_ALLOW_SYSTEM_CA=false

# Authentication (use independent, cryptographically random values)
JSON_WEB_SECRET=REPLACE_WITH_RANDOM_ACCESS_TOKEN_SECRET
JSON_WEB_REFRESH_SECRET=REPLACE_WITH_RANDOM_REFRESH_TOKEN_SECRET
SIGNUP_TOKEN_SECRET=REPLACE_WITH_RANDOM_SIGNUP_TOKEN_SECRET
RESET_TOKEN_SECRET=REPLACE_WITH_RANDOM_RESET_TOKEN_SECRET
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
SIGNUP_TOKEN_TTL=30m
OTP_MAX_ATTEMPTS=5

# Stripe
STRIPE_SECRET_KEY=sk_live_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Firebase Admin (single-line JSON service-account document)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"REPLACE_ME","private_key_id":"REPLACE_ME","private_key":"-----BEGIN PRIVATE KEY-----\\nREPLACE_ME\\n-----END PRIVATE KEY-----\\n","client_email":"REPLACE_ME","client_id":"REPLACE_ME"}

# Transactional email
GMAIL_USER=notifications@example.com
GMAIL_APP_PASSWORD=REPLACE_WITH_APP_PASSWORD

# Cloudinary
CLOUDINARY_CLOUD_NAME=REPLACE_ME
CLOUDINARY_API_KEY=REPLACE_ME
CLOUDINARY_API_SECRET=REPLACE_ME

# Social sign-in
APPLE_CLIENT_ID=ca.dinewell.app
GOOGLE_CLIENT_ID=REPLACE_WITH_OAUTH_CLIENT_ID.apps.googleusercontent.com

# One-time admin bootstrap (set only while running bootstrap:admin, then remove)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_STRONG_TEMPORARY_PASSWORD
BOOTSTRAP_ADMIN_NAME=Administrator
ADMIN_BOOTSTRAP_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ALLOW_ADDITIONAL_ADMIN=false
